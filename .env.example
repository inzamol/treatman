# ==============================================================================
# TM Environment Variables
# ==============================================================================

# OmniRoute Gateway (https://www.omniroute.online/)
# If running OmniRoute locally, default is http://localhost:20128/v1
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# OpenRouter Free API Key (Get at https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: Direct Gemini API Key
GEMINI_API_KEY=

# Optional: ElevenLabs Key for hyper-realistic custom cloned voice
ELEVENLABS_API_KEY=

# System Telemetry & Log Level (DEBUG, INFO, WARNING, ERROR)
TM_LOG_LEVEL=INFO
